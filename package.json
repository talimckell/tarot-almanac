    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "jszip": "^3.10.1",
    "next": "^16.3.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
